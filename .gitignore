CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
*.ninja
.ninja_deps
.ninja_log

# IDE & OS files
.idea/
.vscode/
*.iws
*.iml
*.ipr
.DS_Store
Thumbs.db

# CLion / JetBrains
.idea/

# Backup files
*.orig
*.bak
*~
